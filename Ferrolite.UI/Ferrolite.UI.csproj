<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ferrolite.Core\Ferrolite.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
     
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Ferrolite</AssemblyName>
    <RootNamespace>Ferrolite.UI</RootNamespace>
    <ApplicationIcon>Resources\ferrolite.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>FerroLite Studio</AssemblyTitle>
    <Product>FerroLite Studio</Product>
    <Description>Macro Automation Tool with the Ferrolite scripting language</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\ferrolite.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

</Project>
